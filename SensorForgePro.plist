<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- mediaserverd (iOS 16) ist der Capture-Daemon: BW-Node-Graph + FigCapture.
		     Nur hier injizieren; KEINE Bundles (mediaserverd hat keine Bundle-ID). -->
		<key>Executables</key>
		<array>
			<string>mediaserverd</string>
		</array>
		<!-- Processes  ist das Legacy-Aequivalent fuer aeltere FineLoader/Substrate-Filter. -->
		<key>Processes</key>
		<array>
			<string>mediaserverd</string>
		</array>
		<!-- App-Pfad: Foto-EXIF wird von BWPhotoEncoderNode aus
		     AVCapturePhotoSettings.metadata DER APP gebaut — Frame-Attachments
		     erreichen Fotos nicht. Deshalb in der Kamera-App (und erweiterbar
		     um jede Foto-App-Bundle-ID) injizieren. ProCamera liest seine
		     LIVE-ISO ueber eigene CCMedia-Wrapper/KVO/Notifications —
		     deshalb ist com.cocologics.ProCamera hier explizit gelistet. -->
		<key>Bundles</key>
		<array>
			<string>com.apple.camera</string>
			<string>com.cocologics.ProCamera</string>
			<string>com.zhiliaoapp.musically</string>
			<string>com.burbn.instagram</string>
		</array>
		<key>Mode</key>
		<string>Any</string>
	</dict>
</dict>
</plist>
